# --- Branding: make it yours (all optional; defaults shown) ---
# VITE_BRAND_NAME=VARHub
# VITE_ORG_NAME=VARLab
# VITE_TAGLINE=Augmented and virtual reality experiences, right in your browser. No app to install.
# Also replace public/logo192.png, public/logo512.png and the colours in src/styles.css.

# --- API ---
# Leave empty in development: Vite proxies /api to the server (VITE_PROXY_TARGET, default http://localhost:5000).
# In production, set this to the public address of the API (varhub-server).
VITE_API_URL=
