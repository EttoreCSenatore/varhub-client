# Copy to deploy/.env (never commit it) and fill in the values.

# A domain pointing at this server (Caddy gets the HTTPS certificate), or :80 for plain HTTP.
SITE_ADDRESS=varhub.example.com
# The same address with its scheme; only needed if the API is called from another origin.
ALLOWED_ORIGINS=https://varhub.example.com

# Long random values: `openssl rand -hex 32`
POSTGRES_PASSWORD=
JWT_SECRET=

# Which image version to run (see the releases). `latest` follows main.
VARHUB_VERSION=latest

# Optional: Firebase service account (one-line JSON), only for the admin push route.
FIREBASE_SERVICE_ACCOUNT=

# Optional monitoring (Healthchecks.io or Uptime Kuma push URLs), pinged by the scripts in deploy/.
MONITOR_BACKUP_URL=
MONITOR_DEMO_URL=
